.venv/
.claude/
.env
.env.local
*.env

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Scratch / throwaway scripts (underscore-prefixed) — kept local, never committed
scripts/_*.py

# Eval run artifacts — regenerated on every run (baseline.json IS committed, on purpose)
evals/last_run.json
evals/pr_comment.md

# Harness run artifacts — the per-incident feedback.json the Evaluator writes each run
harness/runs/

# OS junk
.DS_Store

# Node deps (apps/ + web/)
node_modules/

# Local auth store (scrypt password hashes) — never commit
.hivemind-users.json

# Demo recordings (large video binaries; regenerated by scripts/record_real_demo.py)
scripts/demo_recording/

# Deploy credentials (never commit)
gcp-sa-key.json
*.sa.json
.vercel/

# Template
template-solar-main/