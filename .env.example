# HiveMind environment variables — TEMPLATE
# ============================================================================


# --- Google Cloud / Gemini -------------------------------------------------
GOOGLE_API_KEY=AIza...                                
GOOGLE_GENAI_USE_VERTEXAI=True                        
GOOGLE_CLOUD_PROJECT=your-gcp-project-id              
GOOGLE_CLOUD_LOCATION=global                          
AGENT_ENGINE_DEPLOY_REGION=us-central1                
AGENT_ENGINE_STAGING_BUCKET=gs://your-staging-bucket  

# --- MongoDB Atlas (PRIMARY TRACK) ----------------------------------------
MDB_API_PUBLIC_KEY=                                   
MDB_API_PRIVATE_KEY=                                  
MDB_ORG_ID=                                           

# --- Arize AX --------------------------------------------------------------
ARIZE_SPACE_ID=                                       
ARIZE_API_KEY=ak-...                                  

# --- Elastic Cloud ---------------------------------------------------------
ELASTIC_CLOUD_ID=                                     
ELASTIC_API_KEY=                                      
KIBANA_URL=                                           

# --- Dynatrace -------------------------------------------------------------
DT_ENVIRONMENT=https://<env-id>.live.dynatrace.com    
DT_API_TOKEN=dt0c01....                               

# --- GitLab ----------------------------------------------------------------
GITLAB_URL=https://gitlab.com                         
GITLAB_TOKEN=glpat-...                                
GITLAB_TARGET_PROJECT=<your-group>/hivemind-target    

# --- Fivetran --------------------------------------------------------------
FIVETRAN_API_KEY=                                     
FIVETRAN_API_SECRET=                                  
FIVETRAN_GROUP_ID=                                    
FIVETRAN_ALLOW_WRITES=true                            

# --- Local infra (created in later tasks) ----------------------------------
REDIS_URL=redis://localhost:6379                      # local Redis instance; default works for dev
